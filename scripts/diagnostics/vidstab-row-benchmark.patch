+/* PhotoGoGo diagnostic only: compare every byte, not just one frame hash.
+   Both contexts keep their own border history across changing source frames. */
+static void require_ok(int result, const char* operation) {
+  if (result != VS_OK) {
+    fprintf(stderr, "row equivalence failed: %s\n", operation);
+    exit(1);
+  }
+}
+
+static void require_equal(const VSFrame* a, const VSFrame* b,
+                          const VSFrameInfo* fi, const char* label) {
+  int p, y;
+  for (p = 0; p < fi->planes; p++) {
+    int w = fi->width >> vsGetPlaneWidthSubS(fi, p);
+    int h = fi->height >> vsGetPlaneHeightSubS(fi, p);
+    for (y = 0; y < h; y++) {
+      if (memcmp(a->data[p] + y * a->linesize[p],
+                 b->data[p] + y * b->linesize[p], w)) {
+        fprintf(stderr, "%s differs: plane=%d row=%d\n", label, p, y);
+        exit(1);
+      }
+    }
+  }
+}
+
+static int row_equivalence(void) {
+#ifndef USE_OMP
+  fprintf(stderr, "row equivalence requires OpenMP\n");
+  return 1;
+#else
+  int size, threads, crop, ownership, frame, comparisons = 0;
+  omp_set_dynamic(0);
+  for (size = 0; size < 2; size++) {
+    for (threads = 6; threads <= 12; threads += 6) {
+      for (crop = 0; crop <= 1; crop++) {
+        /* Separate buffers, in-place buffers, and alternation of the two. */
+        for (ownership = 0; ownership < 3; ownership++) {
+          VSFrameInfo fi;
+          VSFrame input, src[2], dest[2];
+          VSTransformData td[2];
+          VSTransformConfig conf = vsTransformGetDefaultConfig("row-equivalence");
+          int k;
+          conf.crop = crop;
+          conf.interpolType = VS_BiCubic;
+          conf.lensCorrection = VSLensCorrectOff;
+          conf.fov = 0;
+          vsFrameInfoInit(&fi, size ? 3840 : 640, size ? 2160 : 360, PF_YUV420P);
+          vsFrameAllocate(&input, &fi);
+          for (k = 0; k < 2; k++) {
+            vsFrameAllocate(&src[k], &fi);
+            vsFrameAllocate(&dest[k], &fi);
+            require_ok(vsTransformDataInit(&td[k], &conf, &fi, &fi), "init");
+          }
+          for (frame = 0; frame < 8; frame++) {
+            VSTransform t = {0};
+            VSFrame* output[2];
+            int inplace = ownership == 1 || (ownership == 2 && frame % 2);
+            switch (frame) {
+              case 0: break; /* identity */
+              case 1: t.x = 0.5; t.y = 0.5; break;
+              case 2: t = mk_transform(); break;
+              case 3: t.alpha = -0.05; t.zoom = 4; break;
+              case 4: t.x = -400; t.y = -300; break;
+              case 5: t.alpha = 0.7853981633974483; break;
+              case 6: t.zoom = -60; break;
+              case 7: t.x = 11.75; t.y = -9.25; t.alpha = -0.02; t.zoom = 8; break;
+            }
+            fill(&input, &fi);
+            for (k = 0; k < 2; k++) {
+              int observed = 0;
+              omp_set_num_threads(k ? threads : 1);
+#pragma omp parallel
+              {
+#pragma omp single
+                observed = omp_get_num_threads();
+              }
+              if (observed != (k ? threads : 1)) {
+                fprintf(stderr, "unexpected actual thread count %d\n", observed);
+                return 1;
+              }
+              vsFrameCopy(&src[k], &input, &fi);
+              output[k] = inplace ? &src[k] : &dest[k];
+              require_ok(vsTransformPrepare(&td[k], &src[k], output[k]), "prepare");
+              require_ok(vsDoTransform(&td[k], t), "transform");
+              require_ok(vsTransformFinish(&td[k]), "finish");
+              if (!inplace) require_equal(&src[k], &input, &fi, "read-only input");
+            }
+            require_equal(output[0], output[1], &fi, "serial/parallel output");
+            comparisons++;
+          }
+          printf("equivalent %dx%d threads=1/%d crop=%d ownership=%d frames=8\n",
+                 fi.width, fi.height, threads, crop, ownership);
+          for (k = 0; k < 2; k++) {
+            vsTransformDataCleanup(&td[k]);
+            vsFrameFree(&src[k]);
+            vsFrameFree(&dest[k]);
+          }
+          vsFrameFree(&input);
+        }
+      }
+    }
+  }
+  printf("byte_equal_frame_pairs=%d\n", comparisons);
+  return comparisons == 192 ? 0 : 1;
+#endif
+}
