{
  "format": "photogogo-controller-reference-v1",
  "vendorImportProfile": false,
  "model": "AJAZZ AKP03E",
  "scope": "PhotoGoGo foreground; Photo Lightbox open",
  "buttons": [
    {
      "row": 1,
      "column": 1,
      "commandId": "rate-1-next",
      "keys": "Shift+1",
      "icon": "one-star-next.png"
    },
    {
      "row": 1,
      "column": 2,
      "commandId": "rate-2-next",
      "keys": "Shift+2",
      "icon": "two-stars-next.png"
    },
    {
      "row": 1,
      "column": 3,
      "commandId": "rate-3-next",
      "keys": "Shift+3",
      "icon": "three-stars-next.png"
    },
    {
      "row": 2,
      "column": 1,
      "commandId": "trash-next",
      "keys": "X",
      "icon": "trash-next.png"
    },
    {
      "row": 2,
      "column": 2,
      "commandId": "select-active-next",
      "keys": "G",
      "icon": "select-next.png"
    },
    {
      "row": 2,
      "column": 3,
      "commandId": "next",
      "keys": "→",
      "icon": "skip.png"
    }
  ],
  "dials": [
    {
      "number": 1,
      "left": "previous",
      "right": "next",
      "press": "crop-version",
      "bindings": {
        "left": "←",
        "right": "→",
        "press": "V"
      }
    },
    {
      "number": 2,
      "left": "zoom-out",
      "right": "zoom-in",
      "press": "fit",
      "bindings": {
        "left": "−",
        "right": "+ / =",
        "press": "0"
      }
    },
    {
      "number": 3,
      "left": "panel-previous",
      "right": "panel-next",
      "press": "select-active",
      "bindings": {
        "left": "[",
        "right": "]",
        "press": "A"
      }
    }
  ],
  "commands": [
    {
      "id": "previous",
      "label": "Previous original photo",
      "group": "Browse",
      "keys": [
        "←"
      ]
    },
    {
      "id": "next",
      "label": "Next original photo / skip",
      "group": "Browse",
      "keys": [
        "→"
      ]
    },
    {
      "id": "first",
      "label": "First photo in this folder",
      "group": "Browse",
      "keys": [
        "Home"
      ]
    },
    {
      "id": "last",
      "label": "Last photo in this folder",
      "group": "Browse",
      "keys": [
        "End"
      ]
    },
    {
      "id": "rate-1",
      "label": "Set one star",
      "group": "Review",
      "keys": [
        "1"
      ]
    },
    {
      "id": "rate-2",
      "label": "Set two stars",
      "group": "Review",
      "keys": [
        "2"
      ]
    },
    {
      "id": "rate-3",
      "label": "Set three stars",
      "group": "Review",
      "keys": [
        "3"
      ]
    },
    {
      "id": "clear-rating",
