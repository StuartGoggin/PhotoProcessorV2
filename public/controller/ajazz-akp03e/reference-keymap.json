      "group": "Review",
      "keys": [
        "Backspace"
      ]
    },
    {
      "id": "rate-1-next",
      "label": "Set one star, save and next",
      "group": "Quick review",
      "keys": [
        "Shift+1"
      ]
    },
    {
      "id": "rate-2-next",
      "label": "Set two stars, save and next",
      "group": "Quick review",
      "keys": [
